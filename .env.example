# ── Identity ─────────────────────────────
BOT_NAME=XADON AI
OWNER_NAME=YourName
# Your number with country code, no + (comma for many owners)
OWNER_NUMBER=2348000000000
PREFIX=.

# ── Pairing ──────────────────────────────
PAIRING_NUMBER=
PAIRING_CODE=XADONITE
SESSION_DIR=session
# Paste the browser token here; it starts with xadon~ and is valid for XADON/@musteqeem/baileys.
SESSION_ID=

# ── Behaviour ────────────────────────────
MODE=public
AUTO_READ=false
COOLDOWN_MS=2500

# ── Reply style (12 formats: default mono media rich color html a2ui ads raw clean elder retro) ──
# Change live anytime with: .setformat raw
REPLY_FORMAT=default

# ── Premium badges (toggle live with .premium) ──
AI_BADGE=true
VERIFIED_BADGE=true
META_LABEL=false
CHANNEL_FORWARD=true
CHANNEL_JID=120363423325164241@newsletter
CHANNEL_NAME=XADON AI Updates
WEBSITE_URL=https://github.com/musteqeem/baileys

# ── AI (.ai command) — add ONE key, then .ai hello ──
# Get a free key in 1 min: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=auto

# ── NODAX agent — chats like human, remembers users ──
# Works with NO key (free). Add GROQ_API_KEY above to make Nodax smarter/faster.
# NODAX_MODEL=openai   (free chat model: openai | mistral | llama)
# NODAX_AUTO=off        (on = auto-reply DMs/tags without being called)

# ── Video (.creen / .video) — AI video via creen.ai ──
# Free: bot sends a preview + studio link. With key: bot delivers MP4 in chat.
# Get key at https://www.creen.ai
CREEN_API_KEY=
CREEN_MODEL=sora-2

# ── Web panel ────────────────────────────
PORT=3000
PANEL_KEY=

# ── Menu media / language / font ──
MENU_IMAGE=assets/banner.png
MENU_AUDIO=assets/xadon.mp3
BOT_LANG=en
BOT_FONT=bold
